{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.4.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "permissions": ["storage", "cookies", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.biliimg.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*",
    "https://api.moonshot.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/", "https://www.bilibili.com/watchlater/*"],
      "js": ["src/shared.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/watchlater/*", "https://www.bilibili.com/list/watchlater", "https://www.bilibili.com/bangumi/play/*"],
      "js": ["src/comment-location.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/watchlater/*", "https://www.bilibili.com/list/watchlater", "https://www.bilibili.com/bangumi/play/*"],
      "js": ["src/comment-location-settings.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_extensionActionTitle__"
  }
}
